# Copy to .env.local (development) or set in your host's secret manager (production).
# Never commit real values. None of these use the NEXT_PUBLIC_ prefix, so they stay on the server.

# PostgreSQL connection for the app. Use a role WITHOUT superuser/BYPASSRLS so row-level security applies.
# Production: require TLS, e.g. ...?sslmode=require
DATABASE_URL=postgres://tenth_app:change-me@127.0.0.1:5432/tenth

# Separate database used only by `npm run test:integration` and `npm run test:e2e` (it is wiped by tests).
DATABASE_URL_TEST=postgres://tenth_app:change-me@127.0.0.1:5432/tenth_test

# Better Auth: a long random secret (at least 32 characters), e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public origin of the app. Use https:// in production.
BETTER_AUTH_URL=http://localhost:3000

# The only account allowed to exist. Create it with `npm run owner:create` or the one-time /setup page.
OWNER_EMAIL=you@example.com
# One-time secret required by the /setup page (leave empty to disable web setup and use the CLI instead).
OWNER_SETUP_TOKEN=
